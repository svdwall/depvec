#!/usr/bin/env python3
"""Open DepVec Graph Studio from LLVM IR or an existing graph JSON export."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from tempfile import TemporaryDirectory
from urllib.parse import urlsplit
import webbrowser


ROOT = Path(__file__).resolve().parent.parent
FRONTEND = ROOT / "src" / "frontend"
BACKEND = Path(os.environ.get("DEPVEC_BACKEND", ROOT / "build" / "backend" / "depvec"))
MAX_GRAPH_BYTES = 16 * 1024 * 1024
VERIFY_TIMEOUT_SECONDS = 120


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Open Graph Studio from an LLVM IR file or an existing graph JSON export."
    )
    parser.add_argument("input", type=Path, help="LLVM IR module (.ll) or DepVec graph JSON export")
    parser.add_argument(
        "--port", type=int, default=0,
        help="local web server port (default: choose an available port)",
    )
    parser.add_argument(
        "--no-open", action="store_true",
        help="print the local URL without opening a browser",
    )
    return parser.parse_args()


def build_graphs(ir_file: Path, graph_file: Path) -> None:
    if not (os.environ.get("LLVM_OPT") or shutil.which("opt")):
        raise RuntimeError("Could not find `opt` on PATH (or in LLVM_OPT).")

    subprocess.run(
        ["make", "graphs", f"IR={ir_file}", f"OUT={graph_file}"],
        cwd=ROOT,
        check=True,
    )


def verify_graph(graph: dict) -> tuple[int, dict]:
    """Run the backend on a graph and return an HTTP status and its results."""
    if not BACKEND.is_file():
        return 503, {"error": f"The backend is not built at {BACKEND}. Run `make build-backend`."}
    with TemporaryDirectory(prefix="depvec-verify-") as verify_dir:
        graph_file = Path(verify_dir) / "graph.json"
        graph_file.write_text(json.dumps(graph), encoding="utf-8")
        try:
            completed = subprocess.run(
                [str(BACKEND), "--json", str(graph_file)],
                capture_output=True, text=True, timeout=VERIFY_TIMEOUT_SECONDS, check=False,
            )
        except subprocess.TimeoutExpired:
            return 504, {"error": f"The backend took longer than {VERIFY_TIMEOUT_SECONDS} seconds."}
        except OSError as error:
            return 503, {"error": f"Could not run the backend: {error}"}
    if completed.returncode != 0:
        message = completed.stderr.strip() or f"The backend exited with status {completed.returncode}."
        return 422, {"error": message}
    try:
        return 200, json.loads(completed.stdout)
    except json.JSONDecodeError:
        return 502, {"error": "The backend did not print valid JSON results."}


def make_handler(ir_file: Path | None, graph_file: Path) -> type[BaseHTTPRequestHandler]:
    class StudioHandler(BaseHTTPRequestHandler):
        def do_GET(self) -> None:
            route = urlsplit(self.path).path
            if route == "/" or route == "/index.html":
                self.send_file(FRONTEND / "index.html", "text/html; charset=utf-8")
            elif route == "/app.js":
                self.send_file(FRONTEND / "app.js", "text/javascript; charset=utf-8")
            elif route == "/styles.css":
                self.send_file(FRONTEND / "styles.css", "text/css; charset=utf-8")
            elif route == "/api/ir":
                if ir_file:
                    self.send_file(ir_file, "text/plain; charset=utf-8")
                else:
                    self.send_body(b"", "text/plain; charset=utf-8")
            elif route == "/api/graphs":
                self.send_file(graph_file, "application/json; charset=utf-8")
            elif route == "/api/session":
                body = json.dumps(
                    {"irName": ir_file.name if ir_file else "", "graphName": graph_file.name}
                ).encode("utf-8")
                self.send_body(body, "application/json; charset=utf-8")
            else:
                self.send_error(404)

        def do_POST(self) -> None:
            if urlsplit(self.path).path != "/api/verify":
                self.send_error(404)
                return
            # Only the studio page may run the backend. A cross-site page can
            # send JSON only after a CORS preflight, which this server never
            # answers, and its Origin would not match.
            origin = self.headers.get("Origin")
            if origin and origin != f"http://{self.headers.get('Host')}":
                self.send_json({"error": "Requests from other origins are not allowed."}, 403)
                return
            if self.headers.get_content_type() != "application/json":
                self.send_json({"error": "Send the graph as application/json."}, 415)
                return
            try:
                length = int(self.headers.get("Content-Length", ""))
            except ValueError:
                self.send_json({"error": "Content-Length is required."}, 411)
                return
            if not 0 < length <= MAX_GRAPH_BYTES:
                self.send_json({"error": "The graph is empty or too large."}, 413)
                return
            try:
                graph = json.loads(self.rfile.read(length))
            except (UnicodeDecodeError, json.JSONDecodeError) as error:
                self.send_json({"error": f"The graph is not valid JSON: {error}"}, 400)
                return
            if not isinstance(graph, dict) or graph.get("format") != "depvec-graph-v2":
                self.send_json({"error": "The request is not a depvec-graph-v2 graph."}, 400)
                return
            status, result = verify_graph(graph)
            self.send_json(result, status)

        def send_json(self, value: object, status: int = 200) -> None:
            self.send_body(json.dumps(value).encode("utf-8"),
                           "application/json; charset=utf-8", status)

        def send_file(self, path: Path, content_type: str) -> None:
            try:
                body = path.read_bytes()
            except OSError:
                self.send_error(404)
                return
            self.send_body(body, content_type)

        def send_body(self, body: bytes, content_type: str, status: int = 200) -> None:
            self.send_response(status)
            self.send_header("Content-Type", content_type)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.send_header("X-Content-Type-Options", "nosniff")
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, format_string: str, *args: object) -> None:
            # Keep the terminal focused on the pass output and launcher URL.
            return

    return StudioHandler


def main() -> int:
    args = parse_args()
    input_file = args.input.expanduser().resolve()
    if not input_file.is_file():
        print(f"depvec-studio: input file not found: {input_file}", file=sys.stderr)
        return 2
    if not 0 <= args.port <= 65535:
        print("depvec-studio: --port must be between 0 and 65535", file=sys.stderr)
        return 2

    try:
        with TemporaryDirectory(prefix="depvec-studio-") as session_dir:
            if input_file.suffix.lower() == ".json":
                try:
                    graph_document = json.loads(input_file.read_text(encoding="utf-8"))
                except (OSError, json.JSONDecodeError) as error:
                    raise RuntimeError(f"Could not read graph JSON: {error}") from error
                if not isinstance(graph_document, dict) or graph_document.get("format") != "depvec-graph-v2" or not isinstance(graph_document.get("functions"), list):
                    raise RuntimeError("Input JSON is not a DepVec graph export (expected depvec-graph-v2).")
                ir_file = None
                graph_file = input_file
            else:
                ir_file = input_file
                graph_file = Path(session_dir) / "depvec-graphs.json"
                build_graphs(ir_file, graph_file)

            server = ThreadingHTTPServer(
                ("127.0.0.1", args.port), make_handler(ir_file, graph_file)
            )
            server.daemon_threads = True
            url = f"http://127.0.0.1:{server.server_address[1]}/"
            print(f"DepVec Graph Studio: {url}", flush=True)
            if not args.no_open:
                webbrowser.open(url)
            print("Press Ctrl-C to stop the local server.", flush=True)
            try:
                server.serve_forever()
            except KeyboardInterrupt:
                pass
            finally:
                server.shutdown()
                server.server_close()
    except subprocess.CalledProcessError as error:
        return error.returncode or 1
    except (OSError, RuntimeError) as error:
        print(f"depvec-studio: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
